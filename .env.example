# Demo mode runs with the defaults below. Fill secrets only when you go live.
# Copy this file to .env.local. Never commit .env.local.

BUSINESS_CONFIG=business/northline.yaml
STORE_PATH=data/store.json
DEMO_SEED=true
PUBLIC_BASE_URL=http://127.0.0.1:43123

# Language. Groq is the default. Leave the key empty to use the built-in receptionist.
LLM_PROVIDER=groq
LLM_MODE=tools
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_REASONING_EFFORT=low

# Optional. Set LLM_PROVIDER=gemini and a key to use Gemini instead of Groq.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Calendar: mock | google
CALENDAR_PROVIDER=mock
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=

# CRM: local | google  (tab named Calls, columns A–J)
CRM_PROVIDER=local
GOOGLE_SHEETS_ID=

# SMS: mock | twilio
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_SAY_VOICE=Polly.Joanna-Neural

# Email: mock | resend
EMAIL_PROVIDER=mock
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=

# Optional voice providers. The browser simulator does not need these.
VAPI_WEBHOOK_SECRET=
VAPI_VOICE_PROVIDER=vapi
VAPI_VOICE_ID=Elliot
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
