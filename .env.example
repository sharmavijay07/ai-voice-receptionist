# Demo mode runs with the defaults below. Fill secrets only when you go live.
# Copy this file to .env.local. Never commit .env.local.

BUSINESS_CONFIG=business/northline.yaml
STORE_PATH=data/store.json
DEMO_SEED=true
PUBLIC_BASE_URL=http://127.0.0.1:43123

# Language. Groq is the default. Leave the key empty to use the built-in receptionist.
LLM_PROVIDER=groq
LLM_MODE=tools
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_REASONING_EFFORT=low

# Optional. Set LLM_PROVIDER=gemini and a key to use Gemini instead of Groq.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Calendar. A service-account JSON plus GOOGLE_CALENDAR_ID turns Google on.
# Set CALENDAR_PROVIDER=off to force the mock even when those values exist.
CALENDAR_PROVIDER=mock
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=

# CRM. GOOGLE_SHEETS_ID plus the service account appends to a Calls tab.
# Set CRM_PROVIDER=off to force the local dashboard only.
CRM_PROVIDER=local
GOOGLE_SHEETS_ID=

# Call log. Free Postgres (Neon or Supabase). Empty keeps data/store.json.
DATABASE_URL=

# SMS: mock | twilio
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_SAY_VOICE=Polly.Joanna-Neural

# Email. Gmail is used when both Gmail values are set, ahead of Resend.
# Leave them empty to log emails on the desk.
EMAIL_PROVIDER=mock
GMAIL_USER=
GMAIL_APP_PASSWORD=
SHOP_OWNER_EMAIL=
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=

# Vapi. VAPI_MODEL_PROVIDER=vapi uses a Vapi-hosted model (no Groq key inside Vapi).
# Set VAPI_MODEL_PROVIDER=groq and VAPI_MODEL=openai/gpt-oss-120b to use Groq there.
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_MODEL_PROVIDER=vapi
VAPI_MODEL=
VAPI_WEBHOOK_SECRET=
VAPI_VOICE_PROVIDER=vapi
VAPI_VOICE_ID=Elliot
TRANSFER_NUMBER=
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
